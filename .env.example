# Configuration Base de données MongoDB
MONGODB_URL=mongodb+srv://<votre_utilisateur>:<votre_mot_de_passe>@<votre_cluster>.mongodb.net/<votre_db>?retryWrites=true&w=majority

# Port du serveur Express
PORT=5000

# Identifiants de connexion pour l'espace de saisie (/neny-mampiditra-saisi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

